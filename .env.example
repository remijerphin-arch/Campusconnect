# Public Supabase project URL — safe to expose to the client.
NEXT_PUBLIC_SUPABASE_URL=https://tviinfhlaihmapxuklvn.supabase.co

# Public/publishable Supabase key — safe for client-side use.
# This is NOT the service-role key; never put the service-role key here.
# Find it in the Supabase dashboard under Project Settings > API.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Google API key used for the app's Google API integrations (client-side).
# Restrict this key to your domain(s) in the Google Cloud Console.
NEXT_PUBLIC_GOOGLE_API_KEY=your-google-api-key
